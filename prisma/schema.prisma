generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Clínica (tenant) ────────────────────────────────────────────────────────
model Clinica {
  id          String   @id @default(uuid())
  nome        String
  cnpj        String?  @unique
  telefone    String?
  email       String?
  endereco    String?
  ativa       Boolean  @default(true)
  criadaEm    DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  usuarios      Usuario[]
  clientes      Cliente[]
  profissionais Profissional[]
  servicos      Servico[]
  agendamentos  Agendamento[]
  cobranças     Cobranca[]
  rotinas       Rotina[]
  pontuacoes    PontuacaoCliente[]
  produtos      ProdutoVitrine[]

  @@map("clinicas")
}

// ── Usuário (acesso ao sistema) ─────────────────────────────────────────────
model Usuario {
  id           String      @id @default(uuid())
  clinicaId    String
  nome         String
  email        String
  senhaHash    String
  perfil       PerfilUsuario
  ativo        Boolean     @default(true)
  criadoEm    DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt

  clinica Clinica @relation(fields: [clinicaId], references: [id])

  @@unique([clinicaId, email])
  @@map("usuarios")
}

enum PerfilUsuario {
  ADMIN
  PROFISSIONAL
  RECEPCIONISTA
}

// ── Cliente ─────────────────────────────────────────────────────────────────
model Cliente {
  id           String   @id @default(uuid())
  clinicaId    String
  nome         String
  telefone     String
  email        String?
  cpf          String?
  dataNascimento DateTime?
  observacoes  String?
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  clinica      Clinica       @relation(fields: [clinicaId], references: [id])
  agendamentos Agendamento[]
  anamneses    Anamnese[]
  rotinas      Rotina[]
  registros    RegistroDiario[]
  fotos        FotoEvolucao[]
  pontuacao    PontuacaoCliente?
  pushTokens   PushToken[]

  @@unique([clinicaId, telefone])
  @@map("clientes")
}

// ── Anamnese ────────────────────────────────────────────────────────────────
model Anamnese {
  id        String   @id @default(uuid())
  clienteId String
  conteudo  Json
  criadaEm  DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@map("anamneses")
}

// ── Profissional ─────────────────────────────────────────────────────────────
model Profissional {
  id           String   @id @default(uuid())
  clinicaId    String
  nome         String
  especialidade String?
  telefone     String?
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  clinica      Clinica          @relation(fields: [clinicaId], references: [id])
  agendamentos Agendamento[]
  disponibilidades DisponibilidadeProfissional[]
  rotinas      Rotina[]

  @@map("profissionais")
}

// ── Disponibilidade do profissional ─────────────────────────────────────────
model DisponibilidadeProfissional {
  id             String @id @default(uuid())
  profissionalId String
  diaSemana      Int    // 0=domingo, 6=sábado
  horaInicio     String // "09:00"
  horaFim        String // "18:00"

  profissional Profissional @relation(fields: [profissionalId], references: [id])

  @@map("disponibilidades_profissional")
}

// ── Serviço ──────────────────────────────────────────────────────────────────
model Servico {
  id           String   @id @default(uuid())
  clinicaId    String
  nome         String
  descricao    String?
  duracaoMinutos Int
  preco        Decimal  @db.Decimal(10, 2)
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  clinica      Clinica       @relation(fields: [clinicaId], references: [id])
  agendamentos Agendamento[]

  @@map("servicos")
}

// ── Agendamento ──────────────────────────────────────────────────────────────
model Agendamento {
  id             String            @id @default(uuid())
  clinicaId      String
  clienteId      String
  profissionalId String
  servicoId      String
  inicio         DateTime
  fim            DateTime
  status         StatusAgendamento @default(PENDENTE)
  observacoes    String?
  criadoEm      DateTime          @default(now())
  atualizadoEm  DateTime          @updatedAt

  clinica      Clinica      @relation(fields: [clinicaId], references: [id])
  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [id])
  servico      Servico      @relation(fields: [servicoId], references: [id])
  cobranca     Cobranca?

  @@index([clinicaId, inicio])
  @@index([profissionalId, inicio])
  @@map("agendamentos")
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
  CONCLUIDO
  NAO_COMPARECEU
}

// ── Cobrança ──────────────────────────────────────────────────────────────────
model Cobranca {
  id             String        @id @default(uuid())
  clinicaId      String
  agendamentoId  String        @unique
  valor          Decimal       @db.Decimal(10, 2)
  formaPagamento FormaPagamento
  status         StatusCobranca @default(PENDENTE)
  pagoEm         DateTime?
  criadaEm      DateTime      @default(now())
  atualizadaEm  DateTime      @updatedAt

  clinica     Clinica     @relation(fields: [clinicaId], references: [id])
  agendamento Agendamento @relation(fields: [agendamentoId], references: [id])

  @@map("cobrancas")
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
}

enum StatusCobranca {
  PENDENTE
  PAGO
  CANCELADO
  ESTORNADO
}

// ── Rotina ───────────────────────────────────────────────────────────────────
// Configurada pela esteticista para cada cliente
model Rotina {
  id             String   @id @default(uuid())
  clinicaId      String
  clienteId      String
  profissionalId String
  nome           String
  descricao      String?
  ativa          Boolean  @default(true)
  criadaEm      DateTime @default(now())
  atualizadaEm  DateTime @updatedAt

  clinica      Clinica      @relation(fields: [clinicaId], references: [id])
  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [id])
  passos       PassoRotina[]
  registros    RegistroDiario[]

  @@map("rotinas")
}

// Cada passo da rotina (ex: "Aplicar sérum vitamina C às 21h")
model PassoRotina {
  id              String          @id @default(uuid())
  rotinaId        String
  nome            String
  produto         String?
  instrucoes      String?
  periodo         PeriodoRotina
  horarioSugerido String?         // "08:00"
  diasSemana      Int[]           // 0=dom, 1=seg, ... 6=sab. Vazio = todos os dias
  ordem           Int             @default(0)
  ativo           Boolean         @default(true)
  criadoEm       DateTime        @default(now())

  rotina     Rotina       @relation(fields: [rotinaId], references: [id], onDelete: Cascade)
  conclusoes ConclusaoPasso[]

  @@map("passos_rotina")
}

enum PeriodoRotina {
  MANHA
  TARDE
  NOITE
  QUALQUER
}

// Registro diário — gerado a cada dia que a cliente interage com a rotina
model RegistroDiario {
  id        String   @id @default(uuid())
  rotinaId  String
  clienteId String
  data      DateTime @db.Date
  criadoEm DateTime @default(now())

  rotina     Rotina       @relation(fields: [rotinaId], references: [id])
  cliente    Cliente      @relation(fields: [clienteId], references: [id])
  conclusoes ConclusaoPasso[]
  fotos      FotoEvolucao[]

  // Calculado após o dia: quanto % foi concluído
  percentualConcluido Float?
  estrelasGanhas      Int?   // 0-5 estrelas conforme o percentual

  @@unique([rotinaId, data])
  @@map("registros_diarios")
}

// Conclusão de um passo em um registro diário
model ConclusaoPasso {
  id               String   @id @default(uuid())
  registroDiarioId String
  passoRotinaId    String
  concluido        Boolean  @default(false)
  concluidoEm     DateTime?

  registroDiario RegistroDiario @relation(fields: [registroDiarioId], references: [id], onDelete: Cascade)
  passoRotina    PassoRotina    @relation(fields: [passoRotinaId], references: [id])

  @@unique([registroDiarioId, passoRotinaId])
  @@map("conclusoes_passo")
}

// Foto de evolução — salva no momento do check
model FotoEvolucao {
  id               String   @id @default(uuid())
  registroDiarioId String
  clienteId        String
  url              String   // URL do Firebase Storage
  legenda          String?
  criadaEm        DateTime @default(now())

  registroDiario RegistroDiario @relation(fields: [registroDiarioId], references: [id], onDelete: Cascade)
  cliente        Cliente        @relation(fields: [clienteId], references: [id])

  @@map("fotos_evolucao")
}

// Pontuação acumulada do cliente (gamificação)
model PontuacaoCliente {
  id             String   @id @default(uuid())
  clinicaId      String
  clienteId      String   @unique
  estrelasTotal  Int      @default(0)
  streakAtual    Int      @default(0)   // dias consecutivos com rotina 100%
  streakMaximo   Int      @default(0)
  ultimoDiaFeito DateTime? @db.Date
  atualizadoEm  DateTime @updatedAt

  clinica Clinica @relation(fields: [clinicaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@map("pontuacao_clientes")
}

// ── Vitrine de produtos (afiliados) ─────────────────────────────────────────
model ProdutoVitrine {
  id            String    @id @default(uuid())
  clinicaId     String
  nome          String
  descricao     String?
  imagemUrl     String?
  preco         Decimal?  @db.Decimal(10, 2)  // apenas exibição, venda é externa
  categoria     String?
  linkParceiro  String    // URL já parametrizada do programa de afiliados
  ativo         Boolean   @default(true)
  destaque      Boolean   @default(false)     // aparece primeiro na vitrine
  ordem         Int       @default(0)
  totalCliques  Int       @default(0)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  clinica  Clinica        @relation(fields: [clinicaId], references: [id])
  cliques  CliqueVitrine[]

  @@index([clinicaId, ativo, ordem])
  @@map("produtos_vitrine")
}

// Rastreamento de cliques — para a esteticista ver performance
model CliqueVitrine {
  id         String   @id @default(uuid())
  produtoId  String
  clienteId  String?  // null = visitante não identificado
  criadoEm  DateTime @default(now())

  produto ProdutoVitrine @relation(fields: [produtoId], references: [id])

  @@index([produtoId, criadoEm])
  @@map("cliques_vitrine")
}

// Token de push notification do dispositivo da cliente
model PushToken {
  id        String   @id @default(uuid())
  clienteId String
  token     String   @unique
  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@map("push_tokens")
}
