# Aplicação
NODE_ENV=development
PORT=3000

# Banco de dados (local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinica_dev?schema=public"

# JWT
JWT_SECRET=mude-este-segredo-em-producao
JWT_EXPIRES_IN=7d

# Cloud SQL (produção — preencher ao fazer deploy no Cloud Run)
# INSTANCE_CONNECTION_NAME=PROJECT_ID:us-central1:clinica-postgres
# DB_USER=clinica_app
# DB_PASSWORD=
# DB_NAME=clinica_db

# Google Cloud (produção)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=

# WhatsApp (Evolution API ou Z-API — a definir)
# WHATSAPP_API_URL=
# WHATSAPP_API_KEY=
